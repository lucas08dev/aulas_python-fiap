endpoints = ["Login", "Produtos", "Pedidos"]

status = [
[200, 200, 401, 200, 500],
[200, 200, 200, 200, 200],
[201, 500, 502, 201, 500]
]

for i in range(len(endpoints)):
    sucessos = 0
    total = len(status[i])
    for info in status[i]:
        if info >= 200 and info <= 299:
            sucessos += 1

    porcentagem = (sucessos / total) * 100

    print(f"Endpoint: {endpoints[i]}")
    print(f"Taxa de sucesso: {porcentagem}%")

    print()


endpoint_menos_eficiente = None
maior_erro = -1

for i in range(len(endpoints)):
    erros = 0
    total = len(status[i])

    for erro in status[i]:
        if erro >= 300:
            erros += 1

    if erros > maior_erro:
        maior_erro = erros
        endpoint_menos_eficiente = endpoints[i]

print(f"Endpoint com mais erros: {endpoint_menos_eficiente} com ({maior_erro} erros)")
print()

for i in range(len(endpoints)):
    contador = 0
    erros_seguidos = False
    for valor in status[i]:
        if valor < 200 or valor > 299:
            contador += 1
        else:
            contador = 0

        if contador == 2:
            erros_seguidos = True

    print(f"{endpoints[i]} teve dois erros seguidos? {erros_seguidos}")
print()

